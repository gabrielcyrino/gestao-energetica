# Copie para backend/.env e ajuste. Em produção use um cofre de segredos.
EE_ENVIRONMENT=demo                     # demo | dev | prod

# Banco de dados — a aplicação lê EE_DATABASE_URL ou, na falta dela, DATABASE_URL
# (variável criada automaticamente pela integração Neon ↔ Vercel).
# SQLite (demonstração local, sem infraestrutura):
EE_DATABASE_URL=sqlite:///./data/energia_demo.db
# PostgreSQL + TimescaleDB local (docker compose):
# EE_DATABASE_URL=postgresql+psycopg://energia:energia@localhost:6473/energia
# Neon (formato do console aceito como está; para carga inicial use a conexão direta, sem "-pooler"):
# EE_DATABASE_URL=postgresql://neondb_owner:SENHA@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

EE_JWT_SECRET=troque-este-segredo-em-producao
EE_JWT_EXPIRE_MINUTES=480
EE_DEMO_AUTH=true                       # false esconde os perfis de um clique no login
EE_INGESTION_API_KEY=demo-ingestion-key  # chave usada pelo gateway OPC UA/MQTT
EE_CORS_ORIGINS=["http://localhost:6471","http://localhost:6470"]
EE_CALC_CACHE_TTL=300
